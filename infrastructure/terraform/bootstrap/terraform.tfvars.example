###############################################################################
# Bootstrap tfvars — copy to terraform.tfvars (gitignored) and fill in.
#
# Run from this directory (local state):
#   az login
#   terraform init
#   terraform apply
#
# After apply, paste the outputs into config/<env>.tfvars and
# config/<env>-backend.hcl in the parent directory, then init the root module:
#   cd ..
#   terraform init -backend-config=config/dev-backend.hcl
###############################################################################

# From `az account show`:
subscription_id = "REPLACE-WITH-SUBSCRIPTION-GUID"
tenant_id       = "REPLACE-WITH-TENANT-GUID"

# Override only if you need to.
# region      = "eastus"
# name_prefix = "kanto"
