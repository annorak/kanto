###############################################################################
# Dev backend — copy to config/dev-backend.hcl (gitignored) and fill in.
#
# State lives in the bootstrap-created Azure Storage account. After running
# bootstrap, paste the outputs into the values below:
#
#   resource_group_name  = bootstrap output `resource_group_shared_name`
#   storage_account_name = bootstrap output `tfstate_storage_account_name`
#   container_name       = bootstrap output `tfstate_container_name`
#
# Apply with:
#   az login                                              # if not already
#   terraform init -reconfigure -backend-config=config/dev-backend.hcl
#   terraform apply -var-file=config/dev.tfvars
###############################################################################

resource_group_name  = "kanto-shared-rg"
storage_account_name = "kantotfstate<RANDOM>"
container_name       = "tfstate"
key                  = "envs/dev/terraform.tfstate"

# Authenticate via the active `az login` session — no keys / connection
# strings live in this file.
use_azuread_auth = true
