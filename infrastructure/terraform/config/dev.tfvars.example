###############################################################################
# Dev environment — copy to config/dev.tfvars (gitignored) and fill in.
###############################################################################

environment    = "dev"
tenancy_ocid   = "ocid1.tenancy.oc1..REPLACE"
compartment_id = "ocid1.compartment.oc1..REPLACE" # bootstrap output: compartment_dev_id

# Networking
vcn_cidr       = "10.20.0.0/16"
operator_cidrs = ["203.0.113.10/32"] # your laptop / CI runner /32

# Public key for emergency SSH to worker nodes:
#   ssh-keygen -t ed25519 -f ~/.ssh/kanto-dev-oke -N ""
ssh_public_key = "ssh-ed25519 AAAA...REPLACE"

# Mew sizing — small in dev.
mew_ocpu_count             = 2
mew_memory_gb              = 16
mew_storage_gb             = 50
mew_instance_count         = 1
mew_backup_retention_days  = 7
mew_enable_public_endpoint = false # Modal does not connect to dev

# OKE sizing — small in dev.
oke_node_ocpus     = 4
oke_node_memory_gb = 16
oke_node_count     = 2
oke_node_count_min = 2
oke_node_count_max = 4

# Logging / lifecycle defaults are fine for dev.
# app_log_retention_days = 30
# hot_to_archive_days    = 90
