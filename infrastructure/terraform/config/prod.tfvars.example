###############################################################################
# Prod environment — copy to config/prod.tfvars (gitignored) and fill in.
###############################################################################

environment         = "prod"
subscription_id     = "REPLACE-WITH-SUBSCRIPTION-GUID"
tenant_id           = "REPLACE-WITH-TENANT-GUID"
resource_group_name = "kanto-prod-rg" # bootstrap output: resource_group_prod_name

# Networking — must not overlap dev VNet (10.20.0.0/16) in case of peering.
vnet_cidr      = "10.30.0.0/16"
operator_cidrs = [] # tighten to CI runner /32 + on-call IPs

ssh_public_key = "ssh-ed25519 AAAA...REPLACE"

# Mew sizing — design doc Section 7 target: 16 vCPU / 128 GB RAM / 200 GB SSD.
mew_sku_name                  = "GP_Standard_D16s_v3"
mew_storage_gb                = 256
mew_high_availability_enabled = true
mew_backup_retention_days     = 30

# AKS sizing.
aks_kubernetes_version = "1.31"
aks_node_vm_size       = "Standard_D4s_v5"
aks_node_count         = 3

# Modal workload-identity federation. Pull issuer + subject from Modal's docs
# (https://modal.com/docs/guide/identity-federation) and the workspace UI.
modal_oidc_issuer  = "https://oidc.modal.com" # PLACEHOLDER — verify
modal_oidc_subject = "REPLACE-WITH-MODAL-SUBJECT"

app_log_retention_days = 90
